<file path="frontend/src/components/QuizPanel.jsx">
import React, { useEffect, useState } from 'react';
import { generateCourseQuiz, getCourseQuizzes, publishCourseQuiz } from '../services/api';

const generationSteps = ['Retrieving course evidence', 'Designing questions at the right level', 'Preparing a reviewable draft'];

export default function QuizPanel({ courseId, onOpenCourseArchitect }) {
  const [quizzes, setQuizzes] = useState([]);
  const [topic, setTopic] = useState('');
  const [questionCount, setQuestionCount] = useState(5);
  const [difficulty, setDifficulty] = useState('intermediate');
  const [error, setError] = useState('');
  const [isGenerating, setIsGenerating] = useState(false);
  const [publishingId, setPublishingId] = useState(null);
  const [expandedQuizId, setExpandedQuizId] = useState(null);

  const load = async () => {
    try {
      setQuizzes(await getCourseQuizzes(courseId));
    } catch (err) {
      setError(err.message || 'The assessment service is unavailable. Check that the backend is running and that you are signed in.');
    }
  };

  useEffect(() => { load(); }, [courseId]);

  const generate = async (event) => {
    event.preventDefault();
    try {
      setError('');
      setIsGenerating(true);
      await generateCourseQuiz(courseId, {
        topic: topic.trim(),
        question_count: Number(questionCount),
        difficulty,
      });
      setTopic('');
      await load();
    } catch (err) {
      setError(err.message);
    } finally {
      setIsGenerating(false);
    }
  };

  const publish = async (quizId) => {
    try {
      setError('');
      setPublishingId(quizId);
      await publishCourseQuiz(courseId, quizId);
      await load();
    } catch (err) {
      setError(err.message);
    } finally {
      setPublishingId(null);
    }
  };

  const reviewableQuizzes = quizzes.filter((quiz) => quiz.questions.length > 0);
  const planningPlaceholders = quizzes.filter((quiz) => quiz.questions.length === 0);
  const agentQuizzes = reviewableQuizzes.filter((quiz) => quiz.module_id);

  return (
    <div className="quiz-panel">
      <div className="quiz-panel-head assessment-agent-head">
        <div>
          <span className="eyebrow">ASSESSMENT AGENT</span>
          <h3>Evidence in. Meaningful assessment out.</h3>
          <p>Course Architect creates a draft assessment for every approved module. You stay in control of the final student release.</p>
        </div>
        <div className="assessment-agent-stat" aria-label={`${agentQuizzes.length} agent-produced assessment drafts`}>
          <b>{agentQuizzes.length}</b><span>agent-produced<br />draft{agentQuizzes.length === 1 ? '' : 's'}</span>
        </div>
      </div>

      {error && <div className="error-banner">{error}</div>}

      <div className="quiz-grid">
        <form className="quiz-generator glass-card" onSubmit={generate}>
          <div className="agent-form-heading">
            <span className="agent-pulse" aria-hidden="true" />
            <div><h4>Direct Quiz Builder</h4><p>Need a targeted check? Ask the assessment agent for one. Nothing is shared until you approve it.</p></div>
          </div>
          <label>
            What should students be assessed on?
            <input placeholder="e.g. Process scheduling and context switching" value={topic} onChange={(event) => setTopic(event.target.value)} required disabled={isGenerating} />
          </label>
          <div className="quiz-config-row">
            <label>Difficulty
              <select value={difficulty} onChange={(event) => setDifficulty(event.target.value)} disabled={isGenerating}>
                <option value="foundational">Foundational</option>
                <option value="intermediate">Intermediate</option>
                <option value="advanced">Advanced</option>
              </select>
            </label>
            <label>Questions
              <select value={questionCount} onChange={(event) => setQuestionCount(event.target.value)} disabled={isGenerating}>
                <option value="3">3 questions</option>
                <option value="5">5 questions</option>
                <option value="8">8 questions</option>
                <option value="10">10 questions</option>
              </select>
            </label>
          </div>
          {isGenerating && <div className="quiz-generation-steps" aria-live="polite">
            {generationSteps.map((step, index) => <span key={step}><b>{index + 1}</b>{step}</span>)}
          </div>}
          <button className="button button-primary" disabled={isGenerating}>
            {isGenerating ? 'Building quiz draft…' : 'Generate quiz with AI →'}
          </button>
        </form>

        <div className="quiz-list">
          {quizzes.length === 0 ? (
            <div className="quiz-empty glass-card">
              <span className="quiz-empty-kicker">NO MODULE ASSESSMENTS YET</span>
              <strong>Let Course Architect create the first assessment set.</strong>
              <p>It maps your uploaded material into modules, then Lesson Producer creates one source-grounded quiz draft per approved module.</p>
              <button type="button" className="button button-secondary" onClick={onOpenCourseArchitect}>Open Course Architect →</button>
            </div>
          ) : <>
            {planningPlaceholders.length > 0 && <div className="quiz-placeholder-note">
              <span aria-hidden="true">i</span><p><b>{planningPlaceholders.length} old planning {planningPlaceholders.length === 1 ? 'placeholder is' : 'placeholders are'} hidden from review.</b> They contain no questions and cannot be published. New Course Architect runs create complete drafts instead.</p>
            </div>}
            {reviewableQuizzes.map((quiz) => {
            const citedQuestions = quiz.questions.filter((question) => question.source_page).length;
            const agentProduced = Boolean(quiz.module_id);
            return (
              <article className={`quiz-card glass-card ${agentProduced ? 'quiz-card-agent' : ''}`} key={quiz.id}>
                <div className="quiz-card-top"><span className={`badge ${quiz.status === 'published' ? 'quiz-published' : 'lec-badge'}`}>{quiz.status}</span><span className="quiz-ai-label">{agentProduced ? 'Course Architect output' : 'Direct Quiz Builder'}</span></div>
                <h4>{quiz.title}</h4>
                <p>{quiz.questions.length} questions · {citedQuestions || quiz.questions.length} source-linked · {quiz.status === 'published' ? 'available to students' : 'professor review required'}</p>
                <div className="quiz-card-actions">
                  <button className="text-action" onClick={() => setExpandedQuizId(expandedQuizId === quiz.id ? null : quiz.id)}>{expandedQuizId === quiz.id ? 'Hide draft' : 'Review questions'}</button>
                  {quiz.status !== 'published' && <button className="button button-secondary" onClick={() => publish(quiz.id)} disabled={publishingId === quiz.id}>{publishingId === quiz.id ? 'Publishing…' : 'Approve & publish to students'}</button>}
                </div>
                {expandedQuizId === quiz.id && <div className="quiz-review-list">
                  {quiz.questions.map((question, index) => <section className="quiz-review-question" key={question.id}>
                    <div className="quiz-review-meta">QUESTION {index + 1}{question.source_page ? ` · SOURCE PAGE ${question.source_page}` : ''}</div>
                    <strong>{question.prompt}</strong>
                    <ol type="A">{question.options.map((option, optionIndex) => <li className={optionIndex === question.correct_option ? 'correct-option' : ''} key={`${question.id}-${optionIndex}`}>{option}</li>)}</ol>
                    <p><b>Why:</b> {question.explanation}</p>
                  </section>)}
                </div>}
              </article>
            );
            })}
          </>}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/pages/CourseWorkspace.jsx">
import React, { useState, useEffect, useCallback } from 'react';
import UploadPanel from '../components/UploadPanel';
import ChatPanel from '../components/ChatPanel';
import QuizPanel from '../components/QuizPanel';
import CourseArchitectPanel from '../components/CourseArchitectPanel';
import {
  getCourseDocuments,
  uploadCourseDocument,
  getCourseLectures,
  sendCourseChatMessage,
} from '../services/api';

export default function CourseWorkspace({
  course,
  onBackToCourses,
  onOpenStudioForCourse,
  onOpenCitation,
  onOpenLecture,
}) {
  const [activeTab, setActiveTab] = useState('overview');
  const [documents, setDocuments] = useState([]);
  const [lectures, setLectures] = useState([]);
  const [isLoadingDocs, setIsLoadingDocs] = useState(false);
  const [isLoadingLectures, setIsLoadingLectures] = useState(false);

  const loadDocuments = useCallback(async () => {
    try {
      setIsLoadingDocs(true);
      const docs = await getCourseDocuments(course.id);
      setDocuments(docs);
    } catch (err) {
      console.warn('Failed to load course documents:', err);
    } finally {
      setIsLoadingDocs(false);
    }
  }, [course.id]);

  const loadLectures = useCallback(async () => {
    try {
      setIsLoadingLectures(true);
      const lecs = await getCourseLectures(course.id);
      setLectures(lecs);
    } catch (err) {
      console.warn('Failed to load course lectures:', err);
    } finally {
      setIsLoadingLectures(false);
    }
  }, [course.id]);

  useEffect(() => {
    loadDocuments();
    loadLectures();
  }, [loadDocuments, loadLectures]);

  const handleDocumentUploaded = () => {
    loadDocuments();
  };

  // Custom upload handler for UploadPanel adapted to course
  const handleCourseUpload = (file, onProgress) => {
    return uploadCourseDocument(course.id, file, onProgress);
  };

  // Custom chat handler for ChatPanel adapted to course
  const handleCourseChat = (queryText) => {
    return sendCourseChatMessage(course.id, queryText);
  };

  return (
    <div className="course-workspace-container">
      {/* Course Top Header */}
      <div className="course-header glass-card">
        <div className="course-header-left">
          <button
            className="back-btn"
            onClick={onBackToCourses}
            title="Back to Courses"
          >
            ← All Courses
          </button>
          <div className="course-title-section">
            <span className="badge course-badge">Course Workspace</span>
            <h1 className="course-main-title">{course.title}</h1>
            {course.description && (
              <p className="course-main-desc">{course.description}</p>
            )}
          </div>
        </div>

        <div className="course-header-actions">
          <button
            className="button button-primary"
            onClick={() => onOpenStudioForCourse(course)}
          >
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style={{ width: 18, height: 18, marginRight: 6 }}>
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
            Generate Lecture
          </button>
        </div>
      </div>

      {/* Workspace Tabs Navigation */}
      <div className="workspace-tabs-bar">
        <button
          className={`tab-btn ${activeTab === 'overview' ? 'active' : ''}`}
          onClick={() => setActiveTab('overview')}
        >
          📊 Overview
        </button>
        <button
          className={`tab-btn ${activeTab === 'documents' ? 'active' : ''}`}
          onClick={() => setActiveTab('documents')}
        >
          📄 Documents ({documents.length})
        </button>
        <button
          className={`tab-btn ${activeTab === 'ask-ai' ? 'active' : ''}`}
          onClick={() => setActiveTab('ask-ai')}
        >
          💬 Ask AI (Course Tutor)
        </button>
        <button
          className={`tab-btn ${activeTab === 'lectures' ? 'active' : ''}`}
          onClick={() => setActiveTab('lectures')}
        >
          🎙️ Lectures ({lectures.length})
        </button>
        <button className={`tab-btn ${activeTab === 'architect' ? 'active' : ''}`} onClick={() => setActiveTab('architect')}>✦ Course Architect</button>
        <button className={`tab-btn ${activeTab === 'quizzes' ? 'active' : ''}`} onClick={() => setActiveTab('quizzes')}>✓ Quizzes</button>
      </div>

      {/* Tab Contents */}
      <div className="workspace-tab-content">
        {/* OVERVIEW TAB */}
        {activeTab === 'overview' && (
          <div className="overview-tab-view">
            <div className="overview-stats-grid">
              <div className="stat-card glass-card">
                <span className="stat-label">Course Documents</span>
                <span className="stat-value">{documents.length}</span>
                <span className="stat-sub">PDF lecture materials indexed</span>
              </div>
              <div className="stat-card glass-card">
                <span className="stat-label">Generated Lectures</span>
                <span className="stat-value">{lectures.length}</span>
                <span className="stat-sub">Structured lectures created</span>
              </div>
              <div className="stat-card glass-card">
                <span className="stat-label">Total Document Pages</span>
                <span className="stat-value">
                  {documents.reduce((acc, d) => acc + (d.pages_count || 0), 0)}
                </span>
                <span className="stat-sub">Pages available for grounding</span>
              </div>
            </div>

            <div className="overview-actions-grid">
              <div className="action-card glass-card" onClick={() => setActiveTab('documents')}>
                <div className="action-icon">📄</div>
                <h3>Upload Course Materials</h3>
                <p>Drag and drop lecture PDFs to ground student questions and lecture synthesis.</p>
                <span className="action-link">Manage Documents →</span>
              </div>

              <div className="action-card glass-card" onClick={() => setActiveTab('ask-ai')}>
                <div className="action-icon">💬</div>
                <h3>Ask Course Tutor</h3>
                <p>Chat with AI grounded strictly in this course's documents with verified page citations.</p>
                <span className="action-link">Open Tutor →</span>
              </div>

              <div className="action-card glass-card" onClick={() => onOpenStudioForCourse(course)}>
                <div className="action-icon">🎙️</div>
                <h3>AI Lecture Studio</h3>
                <p>Synthesize grounded, slide-by-slide lectures with speaker notes and citations.</p>
                <span className="action-link">Open Studio →</span>
              </div>
              <div className="action-card glass-card" onClick={() => setActiveTab('architect')}>
                <div className="action-icon">✦</div>
                <h3>Course Architect</h3>
                <p>Plan modules from your evidence, then create lecture and quiz drafts in a controlled agent run.</p>
                <span className="action-link">Open Agent →</span>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'architect' && <CourseArchitectPanel courseId={course.id} documentCount={documents.length} onOpenQuizzes={() => setActiveTab('quizzes')} />}

        {/* DOCUMENTS TAB */}
        {activeTab === 'documents' && (
          <div className="documents-tab-view">
            <div className="workspace-doc-layout">
              <div className="doc-upload-col">
                <UploadPanel
                  onUploadSuccess={handleDocumentUploaded}
                  customUploader={handleCourseUpload}
                />
              </div>

              <div className="doc-list-col glass-card">
                <div className="doc-list-header">
                  <h3>Indexed Course Documents</h3>
                  <span className="meta-pill">{documents.length} files</span>
                </div>

                {isLoadingDocs ? (
                  <div className="loading-state">Loading documents...</div>
                ) : documents.length === 0 ? (
                  <div className="empty-substate">
                    <p>No documents uploaded to this course yet.</p>
                    <p className="sub-text">Upload a PDF on the left to index course content.</p>
                  </div>
                ) : (
                  <div className="doc-items-container">
                    {documents.map((doc) => (
                      <div key={doc.id} className="doc-item-row">
                        <div className="doc-icon-badge">PDF</div>
                        <div className="doc-info-block">
                          <span className="doc-filename">{doc.filename}</span>
                          <span className="doc-meta-info">
                            {doc.pages_count} pages · {doc.chunks_count} vector chunks · Uploaded {new Date(doc.created_at).toLocaleDateString()}
                          </span>
                        </div>
                        <span className="doc-status-badge">Indexed</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* ASK AI TAB */}
        {activeTab === 'ask-ai' && (
          <div className="ask-ai-tab-view">
            <ChatPanel
              onOpenCitation={onOpenCitation}
              customChatSender={handleCourseChat}
              courseContext={course}
            />
          </div>
        )}

        {/* LECTURES TAB */}
        {activeTab === 'lectures' && (
          <div className="lectures-tab-view">
            <div className="lectures-view-header">
              <div>
                <h3>Course Lectures</h3>
                <p>Lectures generated from this course's documents.</p>
              </div>
              <button
                className="button button-primary"
                onClick={() => onOpenStudioForCourse(course)}
              >
                + New Lecture
              </button>
            </div>

            {isLoadingLectures ? (
              <div className="loading-state">Loading lectures...</div>
            ) : lectures.length === 0 ? (
              <div className="empty-substate glass-card">
                <div className="empty-icon">🎙️</div>
                <h4>No Lectures Generated Yet</h4>
                <p>Use the AI Lecture Studio to synthesize a full slide deck with citations from your course PDFs.</p>
                <button
                  className="button button-primary"
                  onClick={() => onOpenStudioForCourse(course)}
                  style={{ marginTop: '1rem' }}
                >
                  Generate First Lecture
                </button>
              </div>
            ) : (
              <div className="lectures-grid">
                {lectures.map((lec) => (
                  <div key={lec.id} className="lecture-card glass-card">
                    <div className="lecture-card-body">
                      <div className="lec-status-bar">
                        <span className="badge lec-badge">{lec.status || 'draft'}</span>
                        <span className="meta-pill">{lec.difficulty}</span>
                      </div>
                      <h4 className="lec-title">{lec.title}</h4>
                      <p className="lec-topic">Topic: {lec.topic}</p>
                      {lec.learning_objectives && lec.learning_objectives.length > 0 && (
                        <ul className="lec-objectives-preview">
                          {lec.learning_objectives.slice(0, 2).map((obj, i) => (
                            <li key={i}>{obj}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <div className="lecture-card-footer">
                      <span className="meta-pill">
                        ⏱️ {lec.duration_minutes} min · 📑 {lec.slide_count || 0} slides
                      </span>
                      <button
                        className="button button-secondary"
                        onClick={() => onOpenLecture(lec.id, course)}
                      >
                        Open Editor →
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
        {activeTab === 'quizzes' && <QuizPanel courseId={course.id} onOpenCourseArchitect={() => setActiveTab('architect')} />}
      </div>
    </div>
  );
}
