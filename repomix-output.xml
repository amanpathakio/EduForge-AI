/* ==========================================================================
   EduForge AI — Phase 1 RAG CSS Design System
   ========================================================================== */

:root {
    --bg-darker: #09090b;
    --bg-dark: #121214;
    --bg-card: rgba(22, 22, 26, 0.75);
    --border-color: rgba(255, 255, 255, 0.08);
    --border-color-hover: rgba(255, 255, 255, 0.15);
    
    /* Harmonious gradients & branding tokens */
    --accent-purple: #8b5cf6;
    --accent-purple-glow: rgba(139, 92, 246, 0.2);
    --accent-blue: #3b82f6;
    --accent-blue-glow: rgba(59, 130, 246, 0.25);
    --accent-emerald: #10b981;
    --accent-emerald-glow: rgba(16, 185, 129, 0.15);
    --accent-crimson: #ef4444;
    
    /* Typography colors */
    --text-primary: #f4f4f6;
    --text-secondary: #a1a1aa;
    --text-muted: #6b7280;
    
    /* Spacing & borders */
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Base resets & styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--bg-darker);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    position: relative;
    line-height: 1.5;
}

/* Ambient backdrop blur blobs */
.bg-blob {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    z-index: -1;
    opacity: 0.12;
    pointer-events: none;
}

.blob-purple {
    top: -100px;
    left: -100px;
    background: radial-gradient(circle, var(--accent-purple) 0%, transparent 70%);
}

.blob-blue {
    bottom: -100px;
    right: -100px;
    background: radial-gradient(circle, var(--accent-blue) 0%, transparent 70%);
}

/* Custom Scrollbars */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* App layout wrapper */
.app-container {
    width: 100%;
    max-width: 1440px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100vh;
    gap: 1rem;
}

/* Warnings */
.api-warning-banner {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #fca5a5;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    animation: fadeIn 0.4s ease forwards;
    backdrop-filter: blur(8px);
}

.warning-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--accent-crimson);
}

.api-warning-banner code {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    color: #fca5a5;
    font-family: monospace;
    font-size: 0.85rem;
}

.hidden {
    display: none !important;
}

/* ==========================================================================
   Header Component
   ========================================================================== */

.app-header {
    background: rgba(18, 18, 20, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.logo-icon {
    width: 28px;
    height: 28px;
}

.logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 40%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.accent-text {
    background: linear-gradient(135deg, #8b5cf6, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

.phase-badge {
    background: rgba(139, 92, 246, 0.1);
    color: #a78bfa;
    border: 1px solid rgba(139, 92, 246, 0.2);
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: relative;
}

.status-dot::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 50%;
    animation: pulse 1.8s infinite;
}

.status-dot.online {
    background-color: var(--accent-emerald);
}

.status-dot.online::after {
    background-color: var(--accent-emerald);
}

.status-dot.offline {
    background-color: var(--accent-crimson);
}

.status-dot.offline::after {
    background-color: var(--accent-crimson);
}

.status-text {
    color: var(--text-secondary);
}

/* ==========================================================================
   Dashboard Grid & Cards
   ========================================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1rem;
    flex: 1;
    min-height: 0; /* Important for flex child scrolling */
}

/* Glass Card Definition */
.glass-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
}

.glass-card:hover {
    border-color: var(--border-color-hover);
}

/* Control Panel (Left Column) */
.control-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    padding-right: 2px;
}

.card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
}

.title-icon {
    width: 18px;
    height: 18px;
    color: var(--accent-purple);
}

.card-subtitle {
    color: var(--text-secondary);
    font-size: 0.775rem;
    margin-bottom: 1rem;
}

/* Drag and Drop Zone */
.drop-zone {
    border: 2px dashed rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 1.5rem 1rem;
    text-align: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.01);
    transition: var(--transition-smooth);
    position: relative;
}

.drop-zone:hover, .drop-zone.dragover {
    border-color: var(--accent-purple);
    background: rgba(139, 92, 246, 0.04);
}

.hidden-file-input {
    display: none;
}

.drop-zone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.upload-cloud-icon {
    width: 38px;
    height: 38px;
    color: var(--text-secondary);
    transition: var(--transition-smooth);
}

.drop-zone:hover .upload-cloud-icon {
    color: var(--accent-purple);
    transform: translateY(-2px);
}

.upload-text-primary {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
}

.upload-text-secondary {
    font-size: 0.725rem;
    color: var(--text-muted);
}

/* Upload Progress */
.upload-progress-container {
    margin-top: 1rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
}

.filename-text {
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80%;
}

.percentage-text {
    color: var(--accent-purple);
    font-weight: 600;
}

.progress-bar-bg {
    background: rgba(255, 255, 255, 0.05);
    height: 4px;
    border-radius: 2px;
    overflow: hidden;
}

.progress-bar-fill {
    background: linear-gradient(90deg, var(--accent-purple), var(--accent-blue));
    height: 100%;
    transition: width 0.1s ease;
}

.processing-msg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
}

/* Spinners */
.spinner-icon {
    width: 20px;
    height: 20px;
    animation: rotate 1s linear infinite;
}

.spinner-icon.mini {
    width: 14px;
    height: 14px;
}

.spinner-track {
    stroke: rgba(255, 255, 255, 0.1);
}

.spinner-head {
    stroke: var(--accent-purple);
    stroke-linecap: round;
}

/* Feedback message box */
.feedback-box {
    margin-top: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
}

.feedback-box.success {
    background: rgba(16, 185, 129, 0.1);
    color: #6ee7b7;
    border-left: 3px solid var(--accent-emerald);
}

.feedback-box.error {
    background: rgba(239, 68, 68, 0.1);
    color: #fca5a5;
    border-left: 3px solid var(--accent-crimson);
}

/* Stats / DB Metrics Panel */
.stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
}

.stat-item {
    background: rgba(0, 0, 0, 0.15);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.02);
}

.stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.15rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

.stat-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.45rem;
    font-weight: 700;
    color: #ffffff;
}

.stat-value-sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    word-break: break-all;
}

.text-highlight {
    color: var(--accent-purple);
    font-weight: 600;
}

/* Grounding safeguards box */
.rules-card {
    background: rgba(16, 185, 129, 0.02);
    border-color: rgba(16, 185, 129, 0.08);
}

.text-green {
    color: var(--accent-emerald) !important;
}

.rules-desc {
    font-size: 0.775rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.4;
}

.rules-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.rule-bullet {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
}

.bullet-dot {
    width: 5px;
    height: 5px;
    background-color: var(--accent-emerald);
    border-radius: 50%;
    flex-shrink: 0;
}

/* ==========================================================================
   Grounded Chat Workspace (Right Column)
   ========================================================================== */

.chat-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.chat-card-container {
    flex: 1;
    min-height: 0;
    padding: 0;
    overflow: hidden;
}

/* Chat Header styling */
.chat-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
}

.chat-subtitle {
    font-size: 0.775rem;
    color: var(--text-secondary);
}

.icon-button {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
}

.icon-button:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

.icon-button svg {
    width: 18px;
    height: 18px;
}

/* Chat Message Area */
.chat-messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: rgba(0, 0, 0, 0.08);
}

/* Welcome Overlay when chatbot is empty */
.welcome-screen {
    margin: auto;
    max-width: 580px;
    text-align: center;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeIn 0.5s ease;
}

.welcome-icon-container {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--accent-purple-glow), var(--accent-blue-glow));
    border: 1px solid rgba(139, 92, 246, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    color: #c084fc;
}

.welcome-icon {
    width: 32px;
    height: 32px;
}

.welcome-heading {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
}

.welcome-tagline {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 2rem;
}

.welcome-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
}

.step-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    padding: 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: var(--transition-smooth);
}

.step-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.12);
}

.step-num {
    background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
    color: #ffffff;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.6rem;
}

.step-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
}

.step-desc {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.35;
}

/* Suggestion Pills */
.suggestions-container {
    width: 100%;
    margin-top: 0.5rem;
    animation: fadeIn 0.4s ease;
}

.suggestion-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.suggestion-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
}

.suggestion-pill {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.85rem;
    border-radius: 20px;
    font-size: 0.775rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-smooth);
    text-align: left;
}

.suggestion-pill:hover {
    background: rgba(139, 92, 246, 0.06);
    border-color: var(--accent-purple);
    color: var(--text-primary);
    transform: translateY(-1px);
}

/* Conversation bubbles */
.chat-msg {
    display: flex;
    flex-direction: column;
    max-width: 82%;
    animation: slideInBubble 0.25s ease-out forwards;
}

.chat-msg.user {
    align-self: flex-end;
}

.chat-msg.assistant {
    align-self: flex-start;
}

.msg-bubble {
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.5;
    position: relative;
    word-break: break-word;
}

.chat-msg.user .msg-bubble {
    background: linear-gradient(135deg, #6d28d9, #1d4ed8);
    color: #ffffff;
    border-bottom-right-radius: 4px;
    box-shadow: 0 4px 12px rgba(109, 40, 217, 0.15);
}

.chat-msg.assistant .msg-bubble {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-bottom-left-radius: 4px;
}

/* Message Meta & Citations style */
.msg-citations {
    margin-top: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.citations-title {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.citations-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}

.citation-badge {
    background: rgba(139, 92, 246, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.18);
    color: #d8b4fe;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.725rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.citation-badge:hover {
    background: var(--accent-purple-glow);
    border-color: var(--accent-purple);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.15);
}

.citation-badge svg {
    width: 12px;
    height: 12px;
}

/* Typing / AI skeleton loader bubble */
.chat-msg.skeleton .msg-bubble {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    width: 250px;
}

.skeleton-line {
    background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);
    background-size: 200% 100%;
    animation: skeletonShimmer 1.5s infinite;
    height: 10px;
    border-radius: 4px;
    margin-bottom: 0.5rem;
}

.skeleton-line:last-child {
    margin-bottom: 0;
}

.skeleton-line.w-80 { width: 80%; }
.skeleton-line.w-90 { width: 90%; }
.skeleton-line.w-60 { width: 60%; }

/* Input Block */
.chat-input-form {
    padding: 1rem 1.5rem 1.25rem;
    border-top: 1px solid var(--border-color);
}

.input-wrapper {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-smooth);
}

.input-wrapper:focus-within {
    border-color: var(--accent-purple);
    box-shadow: 0 0 0 3px var(--accent-purple-glow);
}

.input-wrapper textarea {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
    resize: none;
    max-height: 100px;
    padding: 0.4rem 0;
}

.input-wrapper textarea::placeholder {
    color: var(--text-muted);
}

.send-button {
    background: var(--accent-purple);
    color: #ffffff;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
    flex-shrink: 0;
}

.send-button:hover:not(:disabled) {
    background: #7c3aed;
    transform: scale(1.05);
}

.send-button:disabled {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    cursor: not-allowed;
}

.send-icon {
    width: 14px;
    height: 14px;
}

/* ==========================================================================
   Citation Drawer Inspector
   ========================================================================== */

.citation-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(9, 9, 11, 0.6);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    animation: fadeIn 0.25s ease forwards;
}

.drawer-content {
    width: 480px;
    height: 100vh;
    border-radius: 0;
    border-left: 1px solid var(--border-color);
    padding: 2rem;
    animation: slideInDrawer 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
}

.citation-type-badge {
    background: rgba(59, 130, 246, 0.1);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.2);
    margin-bottom: 0.35rem;
    display: inline-block;
}

.drawer-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
}

.close-btn {
    padding: 0.5rem;
    border-radius: 50%;
    margin-top: -0.25rem;
}

.drawer-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.section-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.65rem;
}

.retrieved-text-block {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: var(--text-primary);
    line-height: 1.6;
    max-height: 280px;
    overflow-y: auto;
    font-style: normal;
}

.drawer-metadata-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.meta-item:last-child {
    border-bottom: none;
}

.meta-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
}

.meta-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-purple);
}

.meta-value-code {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    width: fit-content;
}

.meta-value-path {
    font-size: 0.775rem;
    color: var(--text-secondary);
    word-break: break-all;
}

.meta-note {
    font-size: 0.65rem;
    color: var(--text-muted);
}

/* Margin Indicator Bar */
.distance-progress-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.distance-bar-bg {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
}

.distance-bar-fill {
    background: linear-gradient(90deg, var(--accent-purple), var(--accent-blue));
    height: 100%;
}

/* ==========================================================================
   Animations & Media Queries
   ========================================================================== */

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
        box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes skeletonShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideInBubble {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideInDrawer {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
}

/* Responsive breakdowns */
@media (max-width: 1024px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
    .app-container {
        height: auto;
        overflow-y: auto;
    }
    .chat-card-container {
        height: 600px;
    }
    .control-panel {
        overflow-y: visible;
    }
}

@media (max-width: 640px) {
    .app-container {
        padding: 0.5rem;
    }
    .welcome-steps {
        grid-template-columns: 1fr;
    }
    .drawer-content {
        width: 100vw;
    }
}
