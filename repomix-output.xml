color: #d7ccff; background: rgba(139,92,246,.2); font-weight: 800; }.architect-course-row > span:nth-child(2) { display: grid; flex: 1; }.architect-course-row b { font-size: .85rem; }.architect-course-row small { color: var(--text-muted); font-size: .72rem; }.architect-course-row i { color: #a78bfa; font-style: normal; }.trust-card { background: linear-gradient(155deg, rgba(24, 45, 67, .75), rgba(18, 18, 25, .85)); }.trust-card p { margin: .8rem 0 1.2rem; }.trust-check { padding: .52rem 0; border-top: 1px solid rgba(255,255,255,.07); color: #d2d3db; font-size: .78rem; }.trust-check span { margin-right: .5rem; color: #63dfaa; }

