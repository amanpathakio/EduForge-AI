import React, { useEffect, useState } from 'react';
import { getPublishedCourseQuizzes, submitQuizAttempt } from '../services/api';

export default function StudentQuizPlayer({ course }) {
  const [quizzes, setQuizzes] = useState([]); const [activeQuiz, setActiveQuiz] = useState(null); const [index, setIndex] = useState(0); const [choice, setChoice] = useState(null); const [feedback, setFeedback] = useState(null); const [error, setError] = useState('');
  useEffect(() => { getPublishedCourseQuizzes(course.id).then(setQuizzes).catch(() => setError('Published quizzes are unavailable while the backend is offline.')); }, [course.id]);
  const question = activeQuiz?.questions[index];
  const answer = async () => { if (choice === null || !question) return; try { setFeedback(await submitQuizAttempt(course.id, activeQuiz.id, question.id, { selected_option: choice })); } catch (e) { setError(e.message); } };
  if (!activeQuiz) return <section className="student-practice glass-card"><span className="eyebrow">PRACTISE</span><h2>{course.title}</h2>{error && <div className="error-banner">{error}</div>}{quizzes.length === 0 ? <p>No professor-published quizzes yet. Use the tutor or revisit the course material while you wait.</p> : <div className="published-quiz-list">{quizzes.map(q => <button className="student-course-card" key={q.id} onClick={() => { setActiveQuiz(q); setIndex(0); setChoice(null); setFeedback(null); }}><span className="student-course-icon">✓</span><span><b>{q.title}</b><small>{q.questions.length} question{q.questions.length === 1 ? '' : 's'} · published by your professor</small><em>Start practice →</em></span></button>)}</div>}</section>;
  return <section className="student-practice glass-card"><button className="back-btn" onClick={() => setActiveQuiz(null)}>← All practice</button><div className="practice-progress"><span>{activeQuiz.title}</span><b>Question {index + 1} of {activeQuiz.questions.length}</b></div><h2>{question.prompt}</h2><div className="practice-options">{question.options.map((option, i) => <button key={i} className={`practice-option ${choice === i ? 'selected' : ''} ${feedback && i === feedback.correct_option ? 'correct' : ''}`} disabled={Boolean(feedback)} onClick={() => setChoice(i)}><span>{String.fromCharCode(65 + i)}</span>{option}</button>)}</div>{feedback ? <div className={`practice-feedback ${feedback.correct ? 'success' : 'retry'}`}><b>{feedback.correct ? 'Correct—well done.' : 'Not quite.'}</b><p>{feedback.explanation}</p>{feedback.source_page && <small>Grounded in course material · page {feedback.source_page}</small>}<button className="button button-primary" onClick={() => { if (index + 1 < activeQuiz.questions.length) { setIndex(index + 1); setChoice(null); setFeedback(null); } else setActiveQuiz(null); }}>{index + 1 < activeQuiz.questions.length ? 'Next question →' : 'Finish practice'}</button></div> : <button className="button button-primary" disabled={choice === null} onClick={answer}>Check answer</button>}</section>;
}
