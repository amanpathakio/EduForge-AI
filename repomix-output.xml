/* ==========================================================================
   2026 visual reset — bright academic studio
   The shared shell is deliberately quiet; AI and evidence get the colour.
   ========================================================================== */
:root {
    --bg-darker: #f6f6f2;
    --bg-dark: #ffffff;
    --bg-card: rgba(255,255,255,.9);
    --border-color: rgba(22, 31, 51, .11);
    --border-color-hover: rgba(58, 72, 116, .24);
    --accent-purple: #5146e5;
    --accent-purple-glow: rgba(81,70,229,.14);
    --accent-blue: #296bd6;
    --accent-blue-glow: rgba(41,107,214,.12);
    --accent-emerald: #0e9b76;
    --accent-emerald-glow: rgba(14,155,118,.12);
    --text-primary: #172033;
    --text-secondary: #586174;
    --text-muted: #7e8797;
    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 24px;
}
body { background: #f6f6f2; color: var(--text-primary); }
body::before { content:''; position:fixed; inset:0; z-index:-2; pointer-events:none; background:radial-gradient(circle at 8% 0%, rgba(93,85,229,.09), transparent 24rem), radial-gradient(circle at 94% 18%, rgba(21,159,129,.08), transparent 26rem); }
