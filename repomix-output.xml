@media (max-width: 880px) { .sidebar-nav { width:72px; padding:.8rem .45rem; }.sidebar-brand > div:not(.sidebar-logo), .brand-sub, .nav-item-label, .active-course-pill { display:none; }.sidebar-brand { justify-content:center; padding:.25rem 0 .8rem; }.nav-item-btn { justify-content:center; padding:.75rem; }.nav-active-indicator { right:6px; }.command-header { align-items:flex-start; flex-direction:column; } }
