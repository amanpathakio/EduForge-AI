import { useEffect, useState } from 'react';
import { getCourseAgentRuns, startCourseArchitect, getLatestCourseBlueprint, approveCourseBlueprint, produceBlueprintLessons } from '../services/api';

export default function CourseArchitectPanel({ courseId, documentCount, onOpenQuizzes }) {
  const [runs, setRuns] = useState([]); const [blueprint, setBlueprint] = useState(null); const [goal, setGoal] = useState('Map the material into a clear learning journey with teachable modules.'); const [busy, setBusy] = useState(false); const [error, setError] = useState('');
  const load = async () => { try { const [history, latest] = await Promise.all([getCourseAgentRuns(courseId), getLatestCourseBlueprint(courseId)]); setRuns(history); setBlueprint(latest); } catch { setRuns([]); } };
  useEffect(() => { load(); }, [courseId]);
  useEffect(() => {
    if (!runs.some((item) => item.status === 'queued' || item.status === 'running')) return undefined;
    const interval = window.setInterval(load, 2500);
    return () => window.clearInterval(interval);
  }, [runs, courseId]);
  const run = async () => { try { setBusy(true); setError(''); const created = await startCourseArchitect(courseId, { goal }); setRuns((current) => [created, ...current]); await load(); } catch (e) { setError(e.message); } finally { setBusy(false); } };
  const approve = async () => { try { setBusy(true); setBlueprint(await approveCourseBlueprint(courseId, blueprint.id)); } catch (e) { setError(e.message); } finally { setBusy(false); } };
  const produce = async () => { try { setBusy(true); setError(''); const queued = await produceBlueprintLessons(courseId, blueprint.id); setRuns((current) => [queued, ...current]); } catch (e) { setError(e.message); } finally { setBusy(false); } };
  const latest = runs[0];
  const working = runs.some((item) => item.status === 'queued' || item.status === 'running');
  return <section className="architect-panel glass-card"><div className="architect-panel-head"><div><p className="eyebrow">AGENTIC COURSE DESIGN</p><h3>Course Architect</h3><p>It plans from source evidence; after approval, Lesson Producer turns every module into a complete slide deck and five-question practice draft.</p></div><span className="agent-live-dot">{busy || working ? 'WORKING' : blueprint?.status === 'approved' ? 'APPROVED' : 'READY'}</span></div>{blueprint && <div className="blueprint-card"><div><b>Course blueprint</b><small>{blueprint.status === 'approved' ? 'Approved — create full teaching drafts when you are ready.' : 'Draft — review and approve before producing full lessons.'}</small></div>{blueprint.status !== 'approved' ? <button className="button button-secondary" disabled={busy || working} onClick={approve}>Approve blueprint</button> : <button className="button button-primary" disabled={busy || working} onClick={produce}>{working ? 'Lesson Producer is working…' : 'Produce full lessons →'}</button>}<ol>{blueprint.modules.map((module) => <li key={module.id}><strong>{module.position}. {module.title}</strong><span>{module.objective}</span><em>Evidence: {module.evidence_pages.length ? `pages ${module.evidence_pages.join(', ')}` : 'source-mapped'}</em></li>)}</ol></div>}{latest ? <div className="architect-run"><div className="architect-run-top"><b>{latest.status === 'awaiting_approval' ? 'Draft artifacts created — review required' : latest.status === 'queued' ? 'Queued — you can leave this page' : latest.status === 'running' ? 'Working in the background — updates every few seconds' : latest.status}</b><small>{new Date(latest.created_at).toLocaleString()}</small></div><div className="architect-steps">{latest.steps?.map((step) => <div key={step.id} className={`architect-step ${step.status}`}><span>{step.status === 'completed' ? '✓' : '•'}</span><div><b>{step.title}</b><small>{step.detail}</small></div></div>)}</div>{latest.result?.artifacts && <div className="architect-result"><b>Created in this run</b><p>{latest.result.artifacts.modules} modules · {latest.result.artifacts.lecture_drafts} lecture drafts · {latest.result.artifacts.quiz_drafts} quiz drafts</p>{latest.result.artifacts.quiz_drafts > 0 && <button type="button" className="text-action" onClick={onOpenQuizzes}>Review generated quiz drafts →</button>}</div>}</div> : <div className="architect-empty"><span>✦</span><p>{documentCount ? 'Start the first evidence-first course design run.' : 'Upload course material first; the agent only works from your authorized evidence.'}</p></div>}<div className="architect-action"><textarea value={goal} onChange={(e) => setGoal(e.target.value)} aria-label="Course Architect goal" /><button className="button button-primary" disabled={busy || working || !documentCount} onClick={run}>{busy ? 'Architect is working…' : 'Create course blueprint →'}</button></div>{error && <p className="architect-error">{error}</p>}</section>;
}
