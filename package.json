{
  "name": "eduforge-ai",
  "version": "1.0.0",
  "description": "EduForge AI - Multi-Course RAG & Lecture Studio Workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && .\\venv\\Scripts\\python -m uvicorn app.main:app --host 127.0.0.1 --port 8010",
    "frontend": "npm run dev --prefix frontend",
    "test": "cd backend && .\\venv\\Scripts\\pytest ../tests -v",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
