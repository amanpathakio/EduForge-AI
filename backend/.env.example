# EduForge AI - Phase 1 RAG Configuration

# Gemini API Key (Required for answer generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Public Supabase project address; never place the service-role key in this file/client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Comma-separated local and Vercel frontend origins; no wildcard with credentials.
FRONTEND_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Database Configuration (PostgreSQL recommended; SQLite fallback supported)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eduforge
DATABASE_URL=sqlite:///data/eduforge.db

# Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Vector Store Configuration
CHROMA_DB_DIR=chroma_db

# File Storage Configuration
UPLOAD_DIR=data/uploads

# Text Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Settings
TOP_K=4
SIMILARITY_THRESHOLD=0.45SIMILARITY_THRESHOLD=0.45
